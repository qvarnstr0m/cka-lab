# Cluster layout. Node names, IPs and MACs are matched by index.

# libvirt NAT network
NET_NAME=cka
NET_BRIDGE=virbr-cka
NET_CIDR_PREFIX=192.168.150
NET_GATEWAY=192.168.150.1
NET_DHCP_START=192.168.150.100
NET_DHCP_END=192.168.150.199

# Nodes: the first one is the control plane
NODES=(cp worker1 worker2)
NODE_IPS=(192.168.150.10 192.168.150.11 192.168.150.12)
NODE_MACS=(52:54:00:ca:fe:10 52:54:00:ca:fe:11 52:54:00:ca:fe:12)

# Resources per VM (memory in MiB, disk in GiB)
CP_VCPUS=2
CP_MEMORY=4096
WORKER_VCPUS=2
WORKER_MEMORY=4096
DISK_SIZE=30

# Where VM disks and the base cloud image live on the host
IMAGE_DIR=/var/lib/libvirt/images/cka

# User created in the VMs and the public key it accepts
VM_USER=ubuntu
SSH_PUBKEY_FILE="${HOME}/.ssh/id_ed25519.pub"
SSH_PRIVKEY_FILE="${HOME}/.ssh/id_ed25519"

# Kubernetes networking. Must not overlap the libvirt network above
# (Calico's default 192.168.0.0/16 would).
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
