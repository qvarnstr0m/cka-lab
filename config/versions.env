# Pinned versions — the single place to change what the lab builds.
# Check these against upstream before the first run and when the CKA
# curriculum moves to a new Kubernetes minor.

# Ubuntu cloud image for the VMs (codename + matching virt-install os-variant)
UBUNTU_RELEASE=noble
UBUNTU_OS_VARIANT=ubuntu24.04
# Cloud image architecture. Must match the host CPU: amd64 (tested) or arm64
# (untested; arm64 KVM guests also need UEFI firmware on the host).
UBUNTU_ARCH=amd64

# Kubernetes minor version installed by `make cluster`.
# The upgrade exercise builds K8S_MINOR_PREV instead and upgrades to K8S_MINOR.
K8S_MINOR="${K8S_MINOR:-1.35}"   # override: make cluster K8S_MINOR=1.34
K8S_MINOR_PREV=1.34

# containerd comes from the Ubuntu archive (package "containerd").
# Leave empty for the release's default version, or pin e.g. "1.7.28-0ubuntu1~24.04.1".
CONTAINERD_VERSION=

# Calico (installed via the Tigera operator manifests)
CALICO_VERSION=v3.30.3
